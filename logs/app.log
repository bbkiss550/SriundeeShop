  AND (? IS NULL OR ? = '' OR o.o_customer_name LIKE CONCAT('%', ?, '%'))
GROUP BY o.ID_order,
         o.o_order_date,
         o.o_order_code,
         o.o_customer_name,
         o.ID_pay_method,
         o.pm_name,
         o.o_send_cost,
         o.o_discount,
         o.o_price_total,
         o.o_price_pledge,
         o.o_price_balance,
         o.o_net,
         o.o_remark
ORDER BY o.o_order_date DESC, o.ID_order DESC

Hibernate: SELECT o.ID_order,
       DATE_FORMAT(o.o_order_date, '%Y-%m-%d') AS o_order_date,
       o.o_order_code,
       o.o_customer_name,
       o.ID_pay_method,
       o.pm_name,
       o.o_send_cost,
       o.o_discount,
       o.o_price_total,
       o.o_price_pledge,
       o.o_price_balance,
       o.o_net,
       o.o_remark,
       GROUP_CONCAT(DISTINCT os.os_name ORDER BY os.ID_order_status SEPARATOR '||') AS order_status_names,
       GROUP_CONCAT(DISTINCT os.os_color ORDER BY os.ID_order_status SEPARATOR '||') AS order_status_colors
FROM q_order o
LEFT JOIN t_order_detail od ON od.ID_order = o.ID_order
LEFT JOIN t_order_status os ON os.ID_order_status = od.ID_order_status
WHERE o.ID_pay_method = 2
  AND COALESCE(o.o_price_balance, 0) > 0
  AND (? IS NULL OR ? = '' OR o.o_order_date >= ?)
  AND (? IS NULL OR ? = '' OR o.o_order_date <= ?)
  AND (? IS NULL OR ? = '' OR o.o_customer_name LIKE CONCAT('%', ?, '%'))
GROUP BY o.ID_order,
         o.o_order_date,
         o.o_order_code,
         o.o_customer_name,
         o.ID_pay_method,
         o.pm_name,
         o.o_send_cost,
         o.o_discount,
         o.o_price_total,
         o.o_price_pledge,
         o.o_price_balance,
         o.o_net,
         o.o_remark
ORDER BY o.o_order_date DESC, o.ID_order DESC

