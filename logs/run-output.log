       o.o_order_date,
       o.o_customer_name,
       COALESCE(o.o_net, 0) AS sales,
       COALESCE(c.press_cost, 0) AS press_cost,
       COALESCE(c.shipping_cost, 0) AS shipping_cost,
       COALESCE(o.o_send_cost, 0) AS ems_cost,
       COALESCE(o.o_net, 0) - COALESCE(c.press_cost, 0) - COALESCE(c.shipping_cost, 0) - COALESCE(o.o_send_cost, 0) AS profit
FROM t_order o
LEFT JOIN (
    SELECT qod.ID_order,
           SUM(CASE WHEN qc.ID_type_cost = 1 THEN CAST(REPLACE(qc.c_price, ',', '') AS NUMERIC(14,2)) ELSE 0 END) AS press_cost,
           SUM(CASE WHEN qc.ID_type_cost = 2 THEN CAST(REPLACE(qc.c_price, ',', '') AS NUMERIC(14,2)) ELSE 0 END) AS shipping_cost
    FROM q_cost_detail cd
    JOIN q_cost qc ON qc.ID_cost = cd.ID_cost
    JOIN q_order_detail qod ON qod.ID_order_detail = cd.ID_order_detail
    WHERE qc.c_delete = 'A'
    GROUP BY qod.ID_order
) c ON c.ID_order = o.ID_order
WHERE o.o_order_date BETWEEN ? AND ?
ORDER BY o.o_order_date DESC, o.ID_order DESC
]
