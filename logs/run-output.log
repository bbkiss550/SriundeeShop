       COUNT(od.ID_order_detail) AS details,
       COALESCE(SUM(od.od_qty), 0) AS qty,
       COALESCE(SUM(od.od_price_total), 0) AS value,
       COALESCE(SUM(CASE WHEN o.ID_pay_method = 2 THEN od.od_price_balance ELSE 0 END), 0) AS balance
