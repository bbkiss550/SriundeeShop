       COALESCE(SUM(CASE WHEN ID_pay_method = 2 THEN o_price_pledge ELSE 0 END), 0) AS pledgePaid
FROM q_order
WHERE o_order_date BETWEEN ? AND ?
GROUP BY o_order_date
ORDER BY o_order_date
]
