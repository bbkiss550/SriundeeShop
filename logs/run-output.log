       SUM(od.od_qty) AS qty,
       SUM(od.od_price_total) AS sales,
       SUM(od.od_price_pledge) AS pledge,
       SUM(CASE WHEN o.ID_pay_method = 2 THEN od.od_price_balance ELSE 0 END) AS balance
