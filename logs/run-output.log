    FROM q_cost
    WHERE c_delete = 'A' AND CAST(c_create_date AS DATE) BETWEEN ? AND ?
    GROUP BY TO_CHAR(CAST(c_create_date AS DATE), 'MM/YYYY'), TO_CHAR(CAST(c_create_date AS DATE), 'YYYY-MM')
