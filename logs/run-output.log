        AND od_filter.ID_order_status = ?
  ))
GROUP BY o.ID_order,
         o.o_order_date,
         o.o_order_code,
         o.o_customer_name,
         o.ID_pay_method,
         o.pm_name,
         o.o_send_cost,
         o.o_discount,
         o.o_price_total,
         o.o_price_pledge,
         o.o_price_balance,
         o.o_net,
         o.o_remark
ORDER BY o.o_order_date DESC, o.ID_order DESC

