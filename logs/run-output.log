       o.o_order_date,
       o.o_customer_name,
       COALESCE(o.o_net, 0) AS sales,
       COALESCE(i.income_amount, 0) AS income_amount,
       COALESCE(c.cost_amount, 0) AS cost_amount,
       COALESCE(i.income_amount, 0) - COALESCE(c.cost_amount, 0) AS profit
FROM t_order o
LEFT JOIN (
    SELECT ID_order,
           SUM(CAST(REPLACE(c_price, ',', '') AS NUMERIC(14,2))) AS income_amount
    FROM q_income
    WHERE c_delete = 'A'
    GROUP BY ID_order
) i ON i.ID_order = o.ID_order
LEFT JOIN (
    SELECT qod.ID_order,
           SUM(CAST(REPLACE(qc.c_price, ',', '') AS NUMERIC(14,2))) AS cost_amount
    FROM q_cost_detail cd
    JOIN q_cost qc ON qc.ID_cost = cd.ID_cost
    JOIN q_order_detail qod ON qod.ID_order_detail = cd.ID_order_detail
    WHERE qc.c_delete = 'A'
    GROUP BY qod.ID_order
) c ON c.ID_order = o.ID_order
WHERE o.o_order_date BETWEEN ? AND ?
ORDER BY o.o_order_date DESC, o.ID_order DESC
]
