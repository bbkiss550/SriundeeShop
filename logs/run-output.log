JOIN t_artist a ON a.ID_art = p.ID_art
JOIN t_type ty ON ty.ID_type = p.ID_type
WHERE o.o_order_date BETWEEN ? AND ?
GROUP BY p.ID_product, p.p_name, a.a_name, ty.t_name
ORDER BY qty DESC, p.p_name
]
